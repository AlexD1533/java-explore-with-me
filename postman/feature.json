  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "API = class {",
          "    constructor(pm) { this.pm = pm; }",
          "    async addUser(user) { return this._req('POST', '/admin/users', user); }",
          "    async addCategory(cat) { return this._req('POST', '/admin/categories', cat); }",
          "    async addEvent(uid, ev) { return this._req('POST', `/users/${uid}/events`, ev); }",
          "    async publishEvent(eid) { return this._req('PATCH', `/admin/events/${eid}`, {stateAction: 'PUBLISH_EVENT'}); }",
          "    async addRequest(uid, eid) { return this._req('POST', `/users/${uid}/requests?eventId=${eid}`, {}); }",
          "    async confirmRequest(uid, eid, reqIds) { ",
          "        return this._req('PATCH', `/users/${uid}/events/${eid}/requests`, {requestIds: reqIds, status: 'CONFIRMED'}); ",
          "    }",
          "    async addComment(uid, eid, comment) {",
          "        return this._req('POST', `/users/${uid}/events/${eid}/comment`, comment);",
          "    }",
          "    async _req(method, path, body) {",
          "        return new Promise((resolve, reject) => {",
          "            this.pm.sendRequest({",
          "                url: 'http://localhost:8080' + path,",
          "                method: method,",
          "                body: JSON.stringify(body),",
          "                header: {'Content-Type': 'application/json'}",
          "            }, (err, res) => err ? reject(err) : res.code < 400 ? resolve(res.json()) : reject(res.text()));",
          "        });",
          "    }",
          "};",
          "RandomUtils = class {",
          "    getUser() { return { name: pm.variables.replaceIn('{{$randomFullName}}'), email: pm.variables.replaceIn('{{$randomEmail}}') }; }",
          "    getCategory() { return { name: pm.variables.replaceIn('{{$randomWord}}') + Date.now() }; }",
          "    getFutureEvent(catId) {",
          "        const m = require('moment');",
          "        return {",
          "            annotation: 'Это тестовая аннотация длиной более двадцати символов',",
          "            category: catId,",
          "            description: 'Это тестовое описание события, которое должно быть длиной более двадцати символов для прохождения валидации',",
          "            location: { lat: 55.7558, lon: 37.6176 },",
          "            paid: false, participantLimit: 10, requestModeration: true,",
          "            title: 'Тестовое событие ' + Date.now(),",
          "            eventDate: m().add(3, 'hours').format('YYYY-MM-DD HH:mm:ss')",
          "        };",
          "    }",
          "};"
        ]
      }
    }
  ],
