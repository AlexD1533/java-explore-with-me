      "request": {
        "method": "GET",
        "url": {"raw": "http://localhost:8080/users/events/{{eventId}}/comments", "host": ["localhost:8080"], "path": ["users", "events", "{{eventId}}", "comments"]}
      }
    },
    {
      "name": "5. Удалить комментарий",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 204\", () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {"raw": "http://localhost:8080/users/comments/{{commentId}}", "host": ["localhost:8080"], "path": ["users", "comments", "{{commentId}}"]}
      }
    },
