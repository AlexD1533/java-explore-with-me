{
  "info": {
    "_postman_id": "comment-tests-correct-paths",
    "name": "Тесты комментариев (Правильные пути)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Создание комментария (Успех)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const main = async () => {\r",
              "    const api = new API(pm);\r",
              "    const rnd = new RandomUtils();\r",
              "\r",
              "    try {\r",
              "        const creator = await api.addUser(rnd.getUser());\r",
              "        const participant = await api.addUser(rnd.getUser());\r",
              "        const category = await api.addCategory(rnd.getCategory());\r",
              "        let event = await api.addEvent(creator.id, rnd.getFutureEvent(category.id));\r",
              "        event = await api.publishEvent(event.id);\r",
              "        const req = await api.addRequest(participant.id, event.id);\r",
              "        await api.confirmRequest(creator.id, event.id, [req.id]);\r",
              "        \r",
              "        pm.collectionVariables.set('userId', participant.id);\r",
              "        pm.collectionVariables.set('eventId', event.id);\r",
              "        \r",
              "        pm.request.url = `http://localhost:8080/users/${participant.id}/events/${event.id}/comment`;\r",
              "        pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ text: \"Отличное событие!\" }) });\r",
              "    } catch(err) { console.error(err); }\r",
              "};\r",
              "setTimeout(main, 100);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));\r",
              "const comment = pm.response.json();\r",
              "pm.collectionVariables.set('commentId', comment.id);\r",
              "pm.test(\"Есть все поля\", () => pm.expect(comment).to.have.all.keys('id', 'text', 'authorName', 'created'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{}"},
        "url": {"raw": "http://localhost:8080/users/1/events/1/comment", "host": ["localhost:8080"], "path": ["users", "1", "events", "1", "comment"]}
      }
    },
    {
      "name": "2. Обновление комментария",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const userId = pm.collectionVariables.get('userId');\r",
              "const eventId = pm.collectionVariables.get('eventId');\r",
              "pm.request.url = `http://localhost:8080/users/${userId}/events/${eventId}/comment`;\r",
              "pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ text: \"Обновленный комментарий!\" }) });"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r",
              "const comment = pm.response.json();\r",
              "pm.test(\"Текст обновлен\", () => pm.expect(comment.text).to.eql(\"Обновленный комментарий!\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{}"},
        "url": {"raw": "http://localhost:8080/users/{{userId}}/events/{{eventId}}/comment", "host": ["localhost:8080"], "path": ["users", "{{userId}}", "events", "{{eventId}}", "comment"]}
      }
    },
    {
      "name": "3. Получить комментарии пользователя",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r",
              "const comments = pm.response.json();\r",
              "pm.test(\"Список не пустой\", () => pm.expect(comments.length).to.be.greaterThan(0));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {"raw": "http://localhost:8080/users/{{userId}}/comments", "host": ["localhost:8080"], "path": ["users", "{{userId}}", "comments"]}
      }
    },
    {
      "name": "4. Получить комментарии события",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
